<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MessageRecord.Views.SettingsView">

  <UserControl.Resources>
    <DataTemplate x:Key="SettingRow">
      <Border Classes="card" Padding="16,13" Margin="0,0,0,8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
            <TextBlock Text="{Binding Title}" Classes="title" />
            <TextBlock Text="{Binding Description}" Classes="mute" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Classes="pill" VerticalAlignment="Center"
                        IsChecked="{Binding IsOn}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Classes="panel page">
    <Grid RowDefinitions="Auto,*">

      <StackPanel Grid.Row="0" Margin="24,22,24,0" Spacing="5">
        <TextBlock Text="設定" Classes="h1" />
        <TextBlock Text="{Binding Note}" Classes="sub" TextWrapping="Wrap" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="24,20,16,20">
        <StackPanel Spacing="18">

          <StackPanel Spacing="10">
            <TextBlock Text="一般" Classes="mute" />
            <ItemsControl ItemsSource="{Binding General}"
                          ItemTemplate="{StaticResource SettingRow}" />
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="紀錄" Classes="mute" />
            <ItemsControl ItemsSource="{Binding Records}"
                          ItemTemplate="{StaticResource SettingRow}" />
          </StackPanel>

          <Border Classes="card" Padding="16,14" IsVisible="{Binding HasStatus}">
            <TextBlock Text="{Binding StatusText}" Classes="mute" TextWrapping="Wrap" />
          </Border>

          <StackPanel Spacing="10" IsVisible="{Binding ShowFileActions}">
            <TextBlock Text="匯入與匯出" Classes="mute" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost boxed" Content="匯出全部" Click="OnExportAll" />
              <Button Classes="ghost boxed" Content="匯入 JSON" Click="OnImport" />
              <Button Classes="ghost" Content="開啟資料夾" Click="OnOpenFolder" />
            </StackPanel>
            <TextBlock Text="{Binding ImportMessage}" Classes="faint" IsVisible="{Binding HasImportMessage}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
