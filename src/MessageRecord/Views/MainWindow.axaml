<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MessageRecord.ViewModels"
        xmlns:views="clr-namespace:MessageRecord.Views"
        xmlns:ctl="clr-namespace:MessageRecord.Controls"
        x:Class="MessageRecord.Views.MainWindow"
        Title="MessageRecord · 通知訊息攔截紀錄"
        Width="1536" Height="1024"
        MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:AppDetailViewModel">
      <views:AppDetailView />
    </DataTemplate>
    <DataTemplate DataType="vm:StatsViewModel">
      <views:StatsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="88,*">

    <!-- ================= 頂列 ================= -->
    <Grid Grid.Row="0" ColumnDefinitions="304,*,Auto"
          PointerPressed="OnTitleBarPressed" DoubleTapped="OnTitleBarDoubleTapped"
          Background="Transparent">

      <StackPanel Grid.Column="0" Name="BrandBlock" Orientation="Horizontal" Spacing="20"
                  VerticalAlignment="Center" Margin="20,0,0,0">
        <ctl:AppIcon AppName="MessageRecord" Width="50" Height="50" />
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="MessageRecord" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="清爽的通知，由你掌控" Classes="faint" />
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="1" Classes="field" Height="48" Width="476"
              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,20,0">
        <Grid ColumnDefinitions="Auto,*" Margin="14,0">
          <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconSearch}"
                VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Classes="plain" Margin="10,0,0,0"
                   Watermark="搜尋應用程式或通知..." Text="{Binding SearchText}" />
        </Grid>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                  VerticalAlignment="Center" Margin="0,0,14,0">
        <Button Classes="caption" ToolTip.Tip="設定" Command="{Binding OpenSettingsCommand}">
          <Path Classes="icon" Data="{StaticResource IconGear}" />
        </Button>
        <StackPanel Name="CaptionButtons" Orientation="Horizontal" Spacing="2">
          <Rectangle Width="1" Height="18" Fill="{StaticResource Line}" Margin="6,0" />
          <Button Classes="caption" Click="OnMinimize" ToolTip.Tip="最小化">
            <Path Classes="icon" Data="{StaticResource IconMinimize}" />
          </Button>
          <Button Classes="caption" Click="OnMaximize" ToolTip.Tip="最大化 / 還原">
            <Path Classes="icon" Data="{StaticResource IconMaximize}" />
          </Button>
          <Button Classes="caption close" Click="OnClose" ToolTip.Tip="關閉">
            <Path Classes="icon" Data="{StaticResource IconClose}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ================= 主體 ================= -->
    <Grid Grid.Row="1" ColumnDefinitions="0.198*,0.319*,0.483*">

      <!-- ~~~~~~~~~~ 側欄 ~~~~~~~~~~ -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto" Margin="20,22,20,36">

        <ListBox Grid.Row="0" Classes="nav"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedSection}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Grid.Column="0" Classes="icon" Data="{Binding Icon}"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="navlabel" Text="{Binding Label}"
                           Margin="26,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="navcount" Text="{Binding CountText}"
                           VerticalAlignment="Center" IsVisible="{Binding HasCount}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Name="ToolNavigation" Margin="0,28,0,0">
          <Rectangle Height="1" Fill="{StaticResource Line}" Margin="13,0,13,12" />
          <ListBox Classes="nav"
                   ItemsSource="{Binding ToolItems}"
                   SelectedItem="{Binding SelectedTool}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*">
                  <Path Grid.Column="0" Classes="icon" Data="{Binding Icon}"
                        VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="navlabel" Text="{Binding Label}"
                             Margin="26,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <!-- 本日攔截 -->
        <Border Grid.Row="2" Name="TodayCard" Classes="card" Padding="22,22" Margin="0,0,0,52">
          <Grid RowDefinitions="Auto,Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="44,*,Auto" Margin="0,0,0,24">
              <Grid Grid.Column="0" Width="34" Height="34" ColumnDefinitions="8,5,8,5,8" VerticalAlignment="Center">
                <Border Grid.Column="0" Height="12" Background="#20BBA9" CornerRadius="2" VerticalAlignment="Bottom" />
                <Border Grid.Column="2" Height="30" Background="#20BBA9" CornerRadius="2" VerticalAlignment="Bottom" />
                <Border Grid.Column="4" Height="23" Background="#34D399" CornerRadius="2" VerticalAlignment="Bottom" />
              </Grid>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3">
                <TextBlock Text="本日攔截" Classes="mute" />
                <TextBlock Classes="bignum" Text="{Binding TodayBlockedText}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding DeltaText}" FontSize="16"
                         Foreground="{StaticResource Green}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </Grid>
            <Grid Grid.Row="2" Name="TodayChart" RowDefinitions="72,Auto">
              <ctl:Sparkline Grid.Row="0"
                             Points="{Binding TodayPoints}"
                             Stroke="{StaticResource Accent}"
                             AreaFill="{StaticResource SparkFill}"
                             StrokeThickness="2" />
              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Text="{Binding HourLabels[0]}" Classes="faint" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{Binding HourLabels[1]}" Classes="faint" FontSize="13"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding HourLabels[2]}" Classes="faint" FontSize="13"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding HourLabels[3]}" Classes="faint" FontSize="13"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding HourLabels[4]}" Classes="faint" FontSize="13"
                           HorizontalAlignment="Right" />
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="3" Margin="4,0,0,0">
          <TextBlock Text="{Binding VersionText}" Classes="faint" />
          <TextBlock Text="{Binding TaglineText}" Classes="faint" />
        </StackPanel>
      </Grid>

      <!-- ~~~~~~~~~~ 中欄：程式清單 ~~~~~~~~~~ -->
      <views:AppListView Grid.Column="1" DataContext="{Binding AppList}"
                         Margin="0,0,18,24" />

      <!-- ~~~~~~~~~~ 右欄：該程式的所有紀錄 ~~~~~~~~~~ -->
      <ContentControl Grid.Column="2" Content="{Binding CurrentPane}" Margin="0,0,18,24" />
    </Grid>
  </Grid>
</Window>

